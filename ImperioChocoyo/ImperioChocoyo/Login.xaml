<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImperioChocoyo.Login"
             Title="Login"
             NavigationPage.HasNavigationBar="False">
    <Grid Background="{AppThemeBinding Light={StaticResource BrushBgLight}, Dark={StaticResource BrushBgPage}}" RowDefinitions="Auto, *">

        <!-- Navbar Flotante -->
        <Border Grid.Row="0" Margin="20,14,20,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBarLight}, Dark={StaticResource HeaderBarDark}}"
                Stroke="#2A3A55" StrokeThickness="1" StrokeShape="RoundRectangle 18"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                        Background="{StaticResource BrushPrimary}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <Label Text="IC" FontSize="11" TextColor="White" FontFamily="PoppinsSemiBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Grid.Column="1" Text="Imperio Chocoyo" TextColor="White"
                       FontFamily="PoppinsSemiBold" FontSize="16"
                       VerticalOptions="Center" Margin="12,0,0,0" />
                <Button Grid.Column="2" Text="Salir" Clicked="OnSalirClicked" Style="{StaticResource BtnHeader}" />
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollView Grid.Row="1" VerticalOptions="Center">
            <VerticalStackLayout Padding="24,28" HorizontalOptions="Center" MaximumWidthRequest="520" WidthRequest="520">

                <Border x:Name="CardLogin" Style="{StaticResource CardStyle}"
                        Opacity="0" TranslationY="28" Padding="34,36"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="22">

                        <!-- Avatar de marca -->
                        <Border WidthRequest="84" HeightRequest="84" Margin="0,4,0,0"
                                Background="{StaticResource BrushPrimary}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 26"
                                HorizontalOptions="Center"
                                Shadow="{Shadow Brush=#7C3AED, Offset='0,8', Radius=18, Opacity=0.5}">
                            <Label Text="IC" FontSize="20" TextColor="White" FontFamily="PoppinsSemiBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Bienvenido de nuevo" Style="{StaticResource LabelHeader}"
                                   FontSize="26" HorizontalTextAlignment="Center" />
                            <Label Text="Ingresa tus credenciales para administrar la flota"
                                   Style="{StaticResource LabelSub}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Campo Usuario -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Correo electrónico" Style="{StaticResource LabelField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry x:Name="TxtUsuario" Style="{StaticResource InputEntry}"
                                       Placeholder="tucorreo@imperiochocoyo.com" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo Contraseña -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Contraseña" Style="{StaticResource LabelField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry x:Name="TxtPassword" IsPassword="True" Style="{StaticResource InputEntry}"
                                       Placeholder="Tu contraseña" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Botón Principal -->
                        <Button Text="INICIAR SESIÓN" Clicked="OnIniciarSesionClicked"
                                Style="{StaticResource BtnPrimary}" Margin="0,6,0,0" />

                        <!-- Link de Registro -->
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="¿No tienes cuenta?" Style="{StaticResource LabelMuted}" VerticalOptions="Center" />
                            <Button Text="Regístrate" Clicked="OnRegistrarClicked"
                                    Style="{StaticResource BtnGhost}" Padding="6,4" HeightRequest="36" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Modal Error -->
        <Grid x:Name="ErrorModal" IsVisible="False" Background="#AA070B14"
              HorizontalOptions="Fill" VerticalOptions="Fill" Grid.RowSpan="2">
            <Border Style="{StaticResource CardStyle}" WidthRequest="380"
                    HorizontalOptions="Center" VerticalOptions="Center" Padding="28"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64"
                            Background="{StaticResource BrushDanger}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 20"
                            HorizontalOptions="Center">
                        <Label Text="!" FontSize="32" TextColor="White" FontFamily="PoppinsBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label x:Name="ErrorModalTitle" Text="Error de autenticación" Style="{StaticResource LabelHeader}"
                           FontSize="18" HorizontalTextAlignment="Center" />
                    <Label x:Name="ErrorModalMessage" Text="Usuario o contraseña incorrectos." Style="{StaticResource LabelSub}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Aceptar" Clicked="OnCerrarModalErrorClicked"
                            Style="{StaticResource BtnPrimary}" WidthRequest="140"
                            HorizontalOptions="Center" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Modal Verificación de Administrador -->
        <Grid x:Name="AdminModal" IsVisible="False" Background="#AA070B14"
              HorizontalOptions="Fill" VerticalOptions="Fill" Grid.RowSpan="2">
            <Border Style="{StaticResource CardStyle}" WidthRequest="400"
                    HorizontalOptions="Center" VerticalOptions="Center" Padding="28"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64"
                            Background="{StaticResource BrushPrimary}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 20"
                            HorizontalOptions="Center">
                        <Label Text="ADM" FontSize="11" TextColor="White" FontFamily="PoppinsSemiBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Confirmación de administrador" Style="{StaticResource LabelHeader}"
                               FontSize="18" HorizontalTextAlignment="Center" />
                        <Label Text="Para registrar un nuevo usuario debes contar con permisos de administrador."
                               Style="{StaticResource LabelSub}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo de administrador" Style="{StaticResource LabelField}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry x:Name="TxtAdminUsuario" Style="{StaticResource InputEntry}"
                                   Placeholder="correo del administrador" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña de administrador" Style="{StaticResource LabelField}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry x:Name="TxtAdminPassword" IsPassword="True" Style="{StaticResource InputEntry}"
                                   Placeholder="contraseña del administrador" />
                        </Border>
                    </VerticalStackLayout>
                    <Label x:Name="AdminErrorLabel" IsVisible="False" TextColor="{StaticResource Danger}"
                           FontFamily="PoppinsRegular" FontSize="12"
                           HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,6,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarVerificacionClicked"
                                Style="{StaticResource BtnOutline}" />
                        <Button Grid.Column="1" Text="Verificar" Clicked="OnVerificarAdminClicked"
                                Style="{StaticResource BtnPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Modal Salir -->
        <Grid x:Name="LogoutModal" IsVisible="False" Background="#AA070B14"
              HorizontalOptions="Fill" VerticalOptions="Fill" Grid.RowSpan="2">
            <Border Style="{StaticResource CardStyle}" WidthRequest="380"
                    HorizontalOptions="Center" VerticalOptions="Center" Padding="28"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="¿Deseas salir de la aplicación?" Style="{StaticResource LabelHeader}"
                           FontSize="18" HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,6,0,0">
                        <Button Grid.Column="0" Text="No" Clicked="OnNoSalirClicked"
                                Style="{StaticResource BtnOutline}" />
                        <Button Grid.Column="1" Text="Sí, salir" Clicked="OnSiSalirClicked"
                                Style="{StaticResource BtnDanger}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>