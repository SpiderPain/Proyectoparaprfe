<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ImperioChocoyo"
             x:Class="ImperioChocoyo.HistorialLista"
             Title="Historial"
             NavigationPage.HasNavigationBar="False">
    <Grid Background="{AppThemeBinding Light={StaticResource BrushBgLight}, Dark={StaticResource BrushBgPage}}" RowDefinitions="Auto, *">

        <!-- Navbar Flotante -->
        <Border Grid.Row="0" Margin="20,14,20,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBarLight}, Dark={StaticResource HeaderBarDark}}"
                Stroke="#2A3A55" StrokeThickness="1" StrokeShape="RoundRectangle 18"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="38" HeightRequest="38"
                            Background="{StaticResource BrushPrimary}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <Label Text="H" FontSize="16" TextColor="White" FontFamily="PoppinsSemiBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="Historial" TextColor="White" FontFamily="PoppinsSemiBold" FontSize="15" />
                        <Label Text="Mantenimientos y eventos" TextColor="{AppThemeBinding Light=#C7D2FE, Dark=#94A3B8}" FontFamily="PoppinsRegular" FontSize="11" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Button x:Name="ThemeToggleButton" Grid.Column="2" Text="Oscuro" Clicked="OnThemeToggleClicked"
                        Style="{StaticResource BtnHeader}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Text="Dashboard" Clicked="OnVolverClicked"
                        Style="{StaticResource BtnHeader}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Text="Salir" Clicked="OnSalirClicked"
                        Style="{StaticResource BtnHeader}" Margin="0,0,8,0" />
                <Button Grid.Column="5" Text="Cerrar sesión" Clicked="OnCerrarSesionClicked"
                        Style="{StaticResource BtnHeader}" />
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="1" MaximumWidthRequest="1100" HorizontalOptions="Center" Margin="20,18"
              RowDefinitions="Auto, *">
            <VerticalStackLayout Grid.Row="0" x:Name="Contenido" Spacing="4" Padding="0,0,0,18">
                <Label Text="Historial registrado" Style="{StaticResource LabelHeader}" FontSize="26" />
                <Label Text="Eventos y mantenimientos de la flota" Style="{StaticResource LabelSub}" FontSize="14" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" StrokeShape="RoundRectangle 22" Padding="22">
                <Grid RowDefinitions="Auto, Auto, Auto, *">
                    <Grid Row="0" ColumnDefinitions="*, Auto">
                        <Label Text="Lista de historial" Style="{StaticResource LabelHeader}" FontSize="17" />
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BadgeBgLight}, Dark={StaticResource BadgeBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderSubtle}}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                                Padding="12,6" VerticalOptions="Center">
                            <Label x:Name="LblConteo" Text="0" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" FontFamily="PoppinsSemiBold" FontSize="13" />
                        </Border>
                    </Grid>

                    <Label Grid.Row="1" x:Name="LblError" IsVisible="False" TextColor="#F87171"
                           FontFamily="PoppinsSemiBold" FontSize="13" LineBreakMode="WordWrap" />

                    <Grid Grid.Row="2" ColumnDefinitions="1.3*, 1.2*, 1.5*, 1*, 150"
                          BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#101A2E}"
                          Padding="14,10" Margin="0,2,0,0">
                        <Label Grid.Column="0" Text="AUTOBÚS" Style="{StaticResource LabelMuted}" FontFamily="PoppinsSemiBold" FontSize="11" />
                        <Label Grid.Column="1" Text="FECHA" Style="{StaticResource LabelMuted}" FontFamily="PoppinsSemiBold" FontSize="11" />
                        <Label Grid.Column="2" Text="TIPO" Style="{StaticResource LabelMuted}" FontFamily="PoppinsSemiBold" FontSize="11" />
                        <Label Grid.Column="3" Text="COSTO" Style="{StaticResource LabelMuted}" FontFamily="PoppinsSemiBold" FontSize="11" />
                        <Label Grid.Column="4" Text="ACCIONES" Style="{StaticResource LabelMuted}" FontFamily="PoppinsSemiBold" FontSize="11" HorizontalTextAlignment="End" />
                    </Grid>

                    <CollectionView Grid.Row="3" x:Name="CvHistorial" Margin="0">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="24" Spacing="12" HorizontalOptions="Center">
                                <Border WidthRequest="64" HeightRequest="64" HorizontalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#101A2E}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                    <Label Text="H" FontSize="24" TextColor="{AppThemeBinding Light=#94A3B8, Dark=White}" FontFamily="PoppinsSemiBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Aún no hay historial registrado" Style="{StaticResource LabelHeader}"
                                       FontSize="15" HorizontalTextAlignment="Center" />
                                <Label Text="Úsalo para registrar el primer evento de la flota"
                                       Style="{StaticResource LabelMuted}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:HistorialModel">
                                <Grid ColumnDefinitions="1.3*, 1.2*, 1.5*, 1*, 150" Padding="14,12" Margin="0,2,0,2">
                                    <Label Grid.Column="0" Text="{Binding AutobusLabel}"
                                           FontFamily="PoppinsSemiBold" FontSize="14"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark={StaticResource TextPrimary}}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding FechaRegistro, StringFormat='{}{0:dd/MM/yyyy}'}"
                                           Style="{StaticResource LabelMuted}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Tipo}"
                                           Style="{StaticResource LabelMuted}" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Costo, StringFormat='{}{0:$#,##0.00}'}"
                                           Style="{StaticResource LabelMuted}" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="4" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                                        <Button Text="Editar" Clicked="OnEditarClicked" CommandParameter="{Binding .}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource ChipBgDark}}"
                                                TextColor="{AppThemeBinding Light=#0F172A, Dark={StaticResource TextPrimary}}"
                                                FontFamily="PoppinsSemiBold" FontSize="12"
                                                CornerRadius="10" HeightRequest="32" Padding="10,0"
                                                IsVisible="{x:Static local:Sesion.EsAdmin}" />
                                        <Button Text="Eliminar" Clicked="OnEliminarClicked" CommandParameter="{Binding .}"
                                                Background="Transparent" TextColor="#F87171"
                                                FontFamily="PoppinsSemiBold" FontSize="12"
                                                CornerRadius="10" HeightRequest="32" Padding="10,0"
                                                IsVisible="{x:Static local:Sesion.EsAdmin}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Button x:Name="BtnRegistrarNuevo" Text="+  Nuevo Registro"
                    Clicked="OnNuevoClicked"
                    Style="{StaticResource BtnSuccess}"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="0,0,8,8" Padding="22,14" CornerRadius="18"
                    Shadow="{Shadow Brush=#059669, Offset='0,8', Radius=20, Opacity=0.5}" />

        </Grid>

        <!-- Modal Eliminar -->
        <Grid x:Name="DeleteModal" IsVisible="False" Background="#AA070B14"
              HorizontalOptions="Fill" VerticalOptions="Fill" Grid.RowSpan="2">
            <Border Style="{StaticResource CardStyle}" WidthRequest="400"
                    HorizontalOptions="Center" VerticalOptions="Center" Padding="28"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64"
                            Background="{StaticResource BrushDanger}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 20"
                            HorizontalOptions="Center">
                        <Label Text="✕" FontSize="30" TextColor="White" FontFamily="PoppinsBold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="¿Eliminar registro?" Style="{StaticResource LabelHeader}"
                           FontSize="19" HorizontalTextAlignment="Center" />
                    <Label Text="El registro se eliminará permanentemente de la base de datos."
                           Style="{StaticResource LabelSub}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarEliminarClicked"
                                Style="{StaticResource BtnOutline}" />
                        <Button Grid.Column="1" Text="Eliminar" Clicked="OnConfirmarEliminarClicked"
                                Style="{StaticResource BtnDanger}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>