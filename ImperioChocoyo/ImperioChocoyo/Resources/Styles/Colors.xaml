<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Paleta Premium Dark -->
    <Color x:Key="Primary">#4F7CFF</Color>
    <Color x:Key="PrimaryDark">#8B5CF6</Color>
    <Color x:Key="PrimaryDarkText">#151A2E</Color>
    <Color x:Key="Secondary">#94A3B8</Color>
    <Color x:Key="SecondaryDarkText">#CBD5E1</Color>
    <Color x:Key="Tertiary">#0F1B33</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="OffBlack">#0B1220</Color>

    <Color x:Key="Gray100">#E2E8F0</Color>
    <Color x:Key="Gray200">#CBD5E1</Color>
    <Color x:Key="Gray300">#94A3B8</Color>
    <Color x:Key="Gray400">#64748B</Color>
    <Color x:Key="Gray500">#475569</Color>
    <Color x:Key="Gray600">#334155</Color>
    <Color x:Key="Gray900">#1E293B</Color>
    <Color x:Key="Gray950">#0F172A</Color>

    <!-- Tokens Premium -->
    <Color x:Key="BgDeep">#0B1220</Color>
    <Color x:Key="BgPage">#0F172A</Color>
    <Color x:Key="Surface">#141E33</Color>
    <Color x:Key="SurfaceAlt">#1A2740</Color>
    <Color x:Key="SurfaceInput">#101A2E</Color>
    <Color x:Key="BorderSubtle">#24324A</Color>
    <Color x:Key="TextPrimary">#F1F5F9</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Info">#38BDF8</Color>

    <Color x:Key="LightBgSoft">#F1F5F9</Color>
    <Color x:Key="FieldBgLight">#F8FAFC</Color>
    <Color x:Key="BorderLight">#CBD5E1</Color>
    <Color x:Key="BorderLightSoft">#E2E8F0</Color>

    <!-- Gradientes -->
    <LinearGradientBrush x:Key="BrushPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F7CFF" Offset="0.0" />
        <GradientStop Color="#8B5CF6" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHeader" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E3A8A" Offset="0.0" />
        <GradientStop Color="#4F7CFF" Offset="0.55" />
        <GradientStop Color="#7C3AED" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushSuccess" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0.0" />
        <GradientStop Color="#059669" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushDanger" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F87171" Offset="0.0" />
        <GradientStop Color="#DC2626" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushWarning" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0.0" />
        <GradientStop Color="#D97706" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushInfo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0.0" />
        <GradientStop Color="#2563EB" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCard" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A2740" Offset="0.0" />
        <GradientStop Color="#121C30" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushBgPage" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0F172A" Offset="0.0" />
        <GradientStop Color="#0B1220" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>